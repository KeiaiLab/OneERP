# OneERP 환경변수 — 모든 설정은 ONEERP_ 접두사를 사용한다.
# .env 파일로 복사하여 로컬 개발에 사용한다: cp .env.example .env

# 공통 설정 (CoreSettings)
ONEERP_FERRETDB_URI=mongodb://localhost:27017
ONEERP_DATABASE_NAME=oneerp
ONEERP_DEFAULT_TENANT=default
ONEERP_DEBUG=false

# Valkey(Redis 호환) 캐시 설정
ONEERP_VALKEY_URL=redis://localhost:6379

# NATS JetStream 설정
ONEERP_NATS_URL=nats://localhost:4222
ONEERP_OUTBOX_POLL_INTERVAL=5

# 서비스별 설정 (서비스 고유 환경변수)
# ONEERP_SERVICE_NAME=gateway  # 각 서비스 config.py에서 기본값 제공

# 바로빌 전자세금계산서 API 설정
# ONEERP_BAROBILL_API_URL=https://api.barobill.co.kr
# ONEERP_BAROBILL_API_KEY=

# 금융결제원 오픈뱅킹 API 설정
# ONEERP_OPENBANKING_API_URL=https://openapi.openbanking.or.kr
# ONEERP_OPENBANKING_CLIENT_ID=
# ONEERP_OPENBANKING_CLIENT_SECRET=

# CODEF 4대보험 API 설정
# ONEERP_CODEF_API_URL=https://api.codef.io
# ONEERP_CODEF_API_KEY=
# ONEERP_CODEF_API_SECRET=

# S3 호환 오브젝트 스토리지 설정 (Ceph/MinIO)
# ONEERP_S3_ENDPOINT_URL=https://s3.example.com
# ONEERP_S3_ACCESS_KEY=
# ONEERP_S3_SECRET_KEY=
# ONEERP_S3_BUCKET=oneerp-attachments

# E2E UI 테스트 설정
# E2E_BASE_URL=http://localhost:3000
# E2E_TEST_USERNAME=admin
# E2E_TEST_PASSWORD=

# FE 서버 사이드 — BE 서비스 URL (로컬 개발 시 기본값이 제공되므로 설정 불필요)
# ONEERP_GATEWAY_URL=http://localhost:8001
# ONEERP_SELLING_URL=http://localhost:8002
# ONEERP_BUYING_URL=http://localhost:8003
# ONEERP_STOCK_URL=http://localhost:8004
# ONEERP_ACCOUNTING_URL=http://localhost:8005
# ONEERP_HR_URL=http://localhost:8006
# ONEERP_PAYROLL_URL=http://localhost:8007
# ONEERP_EXPENSES_URL=http://localhost:8008
# ONEERP_CRM_URL=http://localhost:8009
# ONEERP_ASSETS_URL=http://localhost:8010
# ONEERP_PROJECTS_URL=http://localhost:8011
# ONEERP_QUALITY_URL=http://localhost:8012
# ONEERP_ANALYTICS_URL=http://localhost:8013
# ONEERP_MANUFACTURING_URL=http://localhost:8014
# ONEERP_RPA_URL=http://localhost:8015

# FE 설정 (Next.js — NEXT_PUBLIC_ 접두사)
NEXT_PUBLIC_API_URL=http://localhost:8001

# ================================================================
# MSA 간소화 캠페인 (docs/engineering/msa/CONSOLIDATION.md)
# P2 완료 시 아래 클러스터 URL 이 개별 서비스 URL 을 대체한다.
# 같은 클러스터 내부 참조는 in-process 함수 호출로 전환되어 불필요해진다.
# ================================================================
# ONEERP_SALES_URL=http://sales:8000        # selling+crm+rental+reservation
# ONEERP_COMMERCE_URL=http://commerce:8000  # pos+subscriptions+ecommerce
# ONEERP_SCM_CORE_URL=http://scm-core:8000  # stock+manufacturing+quality+maintenance
# ONEERP_PROCUREMENT_URL=http://procurement:8000  # buying+expenses
# ONEERP_FINANCE_URL=http://finance:8000    # accounting+consolidation+esg
# ONEERP_LEARNING_URL=http://learning:8000  # lms+workreport
# ONEERP_COLLAB_URL=http://collab:8000      # calendar+documents+projects+wiki+board+knowledge+survey
# ONEERP_PORTAL_URL=http://portal:8000      # portal+messenger+mail+directory
# ONEERP_LOGISTICS_URL=http://logistics:8000
# ONEERP_MARKETING_URL=http://marketing:8000
# ONEERP_COMPLIANCE_URL=http://compliance:8000  # compliance+clm+ehs
# ONEERP_IOT_URL=http://iot:8000
# ONEERP_INTEGRATION_HUB_URL=http://integration-hub:8000
# ONEERP_AUTOMATION_ORCHESTRATOR_URL=http://automation-orchestrator:8000

# 이미지 레지스트리·태그
# - Helm/배포 산출물은 아래 registry 를 사용한다.
# - 로컬 docker compose 기본값은 pull 대신 build 이며,
#   registry 이미지를 쓰려면 ONEERP_COMPOSE_PULL_POLICY=missing 또는 always 를 지정한다.
ONEERP_IMAGE_REGISTRY=ghcr.io/oneerp
ONEERP_IMAGE_TAG=latest
# ONEERP_COMPOSE_PULL_POLICY=missing
